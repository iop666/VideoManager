{
    "name":  "videomanager-desktop",
    "productName":  "VideoManager",
    "version":  "0.5.0",
    "description":  "VideoManager Windows 端 — 本地视频管理服务器",
    "main":  "./out/main/index.js",
    "private":  true,
    "scripts":  {
                    "dev":  "electron-vite dev",
                    "start":  "electron-vite preview",
                    "build":  "electron-vite build",
                    "typecheck:node":  "tsc --noEmit -p tsconfig.node.json --composite false",
                    "typecheck:web":  "vue-tsc --noEmit -p tsconfig.web.json --composite false",
                    "typecheck":  "pnpm run typecheck:node \u0026\u0026 pnpm run typecheck:web"
                },
    "devDependencies":  {
                            "@electron-toolkit/utils":  "^4.0.0",
                            "@types/node":  "^26.4.0",
                            "@vitejs/plugin-vue":  "^6.0.8",
                            "electron":  "^44.0.0",
                            "electron-builder":  "^26.15.3",
                            "electron-vite":  "^5.0.0",
                            "sharp":  "^0.35.4",
                            "typescript":  "^5.9.3",
                            "vite":  "^8.2.2",
                            "vue-tsc":  "^3.3.11"
                        },
    "dependencies":  {
                         "@vicons/ionicons5":  "^0.13.0",
                         "fflate":  "^0.8.3",
                         "naive-ui":  "^2.45.3",
                         "pinia":  "^4.0.3",
                         "vue":  "^3.5.42",
                         "vue-router":  "^5.3.0"
                     },
    "build":  {
                  "win":  {
                              "target":  [
                                             "portable"
                                         ],
                              "icon":  "resources/icon.ico"
                          },
                  "files":  [
                                "out/**",
                                "resources/**"
                            ],
                  "appId":  "com.videomanager.desktop",
                  "directories":  {
                                      "buildResources":  "resources",
                                      "output":  "dist"
                                  },
                  "asar":  true,
                  "portable":  {
                                   "artifactName":  "VideoManager-${version}-portable.exe"
                               },
                  "productName":  "VideoManager",
                  "extraResources":  [
                                         {
                                             "to":  "icon.ico",
                                             "from":  "resources/icon.ico"
                                         },
                                         {
                                             "to":  "icon.png",
                                             "from":  "resources/icon.png"
                                         }
                                     ]
              },
    "author":  "VideoManager"
}